{
  "name": "alset-studio-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "productName": "Alset Studio",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "tech.prisma.alset.studio",
    "productName": "Alset Studio",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "linux": { "target": ["AppImage", "deb"], "category": "Development" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
